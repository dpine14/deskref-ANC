import argparse
from pathlib import Path

import numpy as np
import soundfile as sf

from deskref.dsp import Processor

RAW_DIR = Path(__file__).resolve().parents[2] / "data" / "raw"
EPS = 1e-12


def load(path) -> tuple[np.ndarray, int]:
    x, rate = sf.read(path, dtype="float32")
    if x.ndim > 1:
        x = x[:, 0]
    return x, rate


def energy(x: np.ndarray) -> float:
    return float(np.sum(np.square(x, dtype=np.float64)))


def db(x: float) -> float:
    return 10.0 * np.log10(max(x, EPS))


def run(proc, x: np.ndarray, block: int = 1024) -> np.ndarray:
    """Process block by block, like live operation, so filter state is exercised."""
    out = np.empty_like(x)
    for i in range(0, len(x), block):
        out[i : i + block] = proc.process(x[i : i + block])
    return out


def frame_rms(x: np.ndarray, frame: int) -> np.ndarray:
    n = len(x) // frame
    return np.sqrt(np.mean(x[: n * frame].reshape(n, frame).astype(np.float64) ** 2, axis=1))


def noise_floor_rms(silence: np.ndarray, rate: int, frame_ms: float = 10.0) -> float:
    """Median frame RMS, so a stray sound in the silence take doesn't inflate it."""
    return float(np.median(frame_rms(silence, int(rate * frame_ms / 1000))))


def event_mask(x, rate, floor_rms, margin_db=12.0, frame_ms=10.0, pad=2) -> np.ndarray:
    """Per-sample boolean mask of frames well above the noise floor."""
    frame = int(rate * frame_ms / 1000)
    hot = frame_rms(x, frame) > floor_rms * 10 ** (margin_db / 20)
    if pad:
        hot = np.convolve(hot.astype(int), np.ones(2 * pad + 1, int), mode="same") > 0
    mask = np.zeros(len(x), dtype=bool)
    mask[: len(hot) * frame] = np.repeat(hot, frame)
    return mask


def noise_reduction_db(x, y, mask) -> float:
    if not mask.any():
        return float("nan")
    return db(energy(x[mask])) - db(energy(y[mask]))


def level_change_db(x, y) -> float:
    return db(energy(y)) - db(energy(x))


def sdr_db(reference, y) -> float:
    """Reference energy over the energy of (y - reference)."""
    return db(energy(reference)) - db(energy(y - reference))


def mix_improvement(make_proc, speech, noise, block=1024):
    n = min(len(speech), len(noise))
    speech, noise = speech[:n], noise[:n]
    y = run(make_proc(), speech + noise, block)
    before = db(energy(speech)) - db(energy(noise))
    after = sdr_db(speech, y)
    return before, after


def _path(name: str) -> Path:
    return RAW_DIR / f"{name}.wav"


def main():
    p = argparse.ArgumentParser(description="Score the processor on recorded takes")
    p.add_argument("--silence", default="silence_01")
    p.add_argument("--speech", default="speech_01")
    p.add_argument("--typing", default="typing_01")
    p.add_argument("--bumps", default="bumps_02")
    p.add_argument("--block", type=int, default=1024)
    args = p.parse_args()

    sil, rate = load(_path(args.silence))
    floor = noise_floor_rms(sil, rate)
    print(f"rate {rate} Hz, noise floor {20 * np.log10(max(floor, EPS)):.1f} dBFS RMS\n")

    def make():
        return Processor(rate)

    clips = {}
    for label, name in (("typing", args.typing), ("bumps", args.bumps)):
        x, r = load(_path(name))
        assert r == rate, f"{name}: sample rate {r} != {rate}"
        mask = event_mask(x, rate, floor)
        y = run(make(), x, args.block)
        print(f"{label:8s} noise reduction {noise_reduction_db(x, y, mask):6.1f} dB "
              f"({mask.mean() * 100:.0f}% of frames are events)")
        clips[label] = x

    sp, r = load(_path(args.speech))
    assert r == rate
    ys = run(make(), sp, args.block)
    print(f"{'speech':8s} level change   {level_change_db(sp, ys):6.1f} dB, "
          f"SDR {sdr_db(sp, ys):.1f} dB")

    before, after = mix_improvement(make, sp, clips["typing"], args.block)
    print(f"{'mix':8s} speech-to-residual {before:.1f} dB -> {after:.1f} dB "
          f"(improvement {after - before:+.1f} dB)")